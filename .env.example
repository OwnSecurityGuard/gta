# .env.example（T15）——docker compose 环境变量样例。
# 用法：cp .env.example .env，按需修改后 docker compose up -d。

# ============================================================================
# 必填
# ============================================================================

# 鉴权 token，逗号分隔可配多个（gta-pipeline 与 gta-mcp 共用同一份）。
# 生成示例：openssl rand -hex 24 （加 gta_tok_ 前缀，如 gta_tok_xxxxxxxx）
GTA_AUTH_TOKENS=gta_tok_change_me

# ============================================================================
# 可选：端口映射（宿主机侧）
# ============================================================================

# CaptureControl gRPC（gta-mcp / 管理端连接 pipeline）
GTA_CONTROL_PORT=9888
# PluginRegistry gRPC（插件注册）
GTA_REGISTRY_PORT=9091
# AgentIngest gRPC（gta-agent 推流入口）
GTA_AGENT_INGEST_PORT=9092
# MCP HTTP/SSE（团队客户端连接）
GTA_MCP_PORT=8781

# ============================================================================
# 可选：覆盖容器内监听地址（默认 :port 即可，一般不用改）
# 注意 GTA_CONTROL_ADDR 语义随服务而异（pkg/config/app.go）：
#   - pipeline 服务：本进程 CaptureControl gRPC 的监听地址（默认 :9888）；
#   - mcp 服务：要连接的 pipeline CaptureControl 地址——compose 内已固定为
#     pipeline:9888（服务名解析），不要用下面的变量覆盖它。
# ============================================================================

# GTA_CONTROL_ADDR=:9888            # 仅对 pipeline 生效（mcp 已由 compose 指向 pipeline:9888）
# GTA_REGISTRY_ADDR=:9091
# GTA_AGENT_INGEST_ADDR=:9092
# GTA_MCP_ADDR=:8781

# ============================================================================
# 可选：CORS / 版本注入
# ============================================================================

# MCP CORS 允许的 Origin（逗号分隔，如 http://localhost:5173）；留空不返回 CORS 头
GTA_MCP_ALLOWED_ORIGINS=

# 构建镜像时注入的版本号与 commit（与 Makefile 的 -X ldflags 同源）
GTA_VERSION=dev
GTA_GIT_COMMIT=unknown

# ============================================================================
# 可选：gta-agent 客户端连接信息（供团队成员参考，非 compose 使用）
# ============================================================================
# 团队成员本机运行：
#   gta-agent --token gta_tok_xxx --server <服务器IP>:9091
# （ingest 端口自动取 9092）
