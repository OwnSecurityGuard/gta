# .env.example（T15）——docker compose 环境变量样例。
# 用法：cp .env.example .env，按需修改后 docker compose up -d。

# ============================================================================
# 必填
# ============================================================================

# 鉴权 token 表，格式是「owner=token」，逗号分隔可配多个（gt-pipeline 与
# gt-mcp 共用同一份）。裸 token 不带 owner 会被 ParseTokens 拒绝、服务起不来。
# 在 token 后加 :admin 后缀即授予该 owner 管理员权限。
# 生成示例：openssl rand -hex 24 （加 gt_tok_ 前缀，如 gt_tok_xxxxxxxx）
GT_AUTH_TOKENS=alice=gt_tok_change_me:admin,bob=gt_tok_change_me2

# ============================================================================
# 可选：PostgreSQL 存储后端（docker-compose postgres 模式）
# ============================================================================

# compose 里 pipeline/mcp 以 GT_DB_DRIVER=postgres + GT_DB_DSN 连接 PG；
# 下面三个变量同时用于初始化 postgres 容器与拼接 DSN，保持一致即可。
# 默认密码仅限本机开发，正式部署务必改掉。
GT_PG_USER=gametrace
GT_PG_PASSWORD=gt_dev_pass
GT_PG_DB=gametrace

# ============================================================================
# 可选：端口映射（宿主机侧）
# ============================================================================

# CaptureControl gRPC（gt-mcp / 管理端连接 pipeline）
# 注意：docker 模式下宿主侧默认用 1xxxx 偏移端口——本机 GameTrace 链路
# （pipeline/mcp）已占用 9888/9091/9092/8781；容器内端口拓扑不变。
GT_CONTROL_PORT=19888
# PluginRegistry gRPC（插件注册）
GT_REGISTRY_PORT=19091
# AgentIngest gRPC（gt-agent 推流入口）
GT_AGENT_INGEST_PORT=19092
# MCP HTTP/SSE（团队客户端连接，浏览器访问 http://<host>:18781）
GT_MCP_PORT=18781

# ============================================================================
# 可选：覆盖容器内监听地址（默认 :port 即可，一般不用改）
# 注意 GT_CONTROL_ADDR 语义随服务而异（pkg/config/app.go）：
#   - pipeline 服务：本进程 CaptureControl gRPC 的监听地址（默认 :9888）；
#   - mcp 服务：要连接的 pipeline CaptureControl 地址——compose 内已固定为
#     pipeline:9888（服务名解析），不要用下面的变量覆盖它。
# ============================================================================

# GT_CONTROL_ADDR=:9888            # 仅对 pipeline 生效（mcp 已由 compose 指向 pipeline:9888）
# GT_REGISTRY_ADDR=:9091
# GT_AGENT_INGEST_ADDR=:9092
# GT_MCP_ADDR=:8781

# ============================================================================
# 可选：CORS / 版本注入
# ============================================================================

# MCP CORS 允许的 Origin（逗号分隔，如 http://localhost:5173）；留空不返回 CORS 头
GT_MCP_ALLOWED_ORIGINS=

# 构建镜像时注入的版本号与 commit（与 Makefile 的 -X ldflags 同源）
GT_VERSION=dev
GT_GIT_COMMIT=unknown

# 前端「原始包」调试页开关（构建期注入，默认 0=关闭；仅开发/插件调试场景开 1）。
# 镜像内 Web UI 已内嵌进 gt-mcp：docker compose up -d --build 后浏览器直接
# 访问 http://<服务器IP>:8781（静态资源免鉴权；API 调用在页面内填 token）。
VITE_ENABLE_RAW_DEBUG=0

# ============================================================================
# 可选：gt-agent 客户端连接信息（供团队成员参考，非 compose 使用）
# ============================================================================
# 团队成员本机运行：
#   gt-agent --token gt_tok_xxx --server <服务器IP>:9091
# （ingest 端口自动取 9092）
