.env
.env.*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Temporary files
tmp/
temp/
*.tmp

# Frontend build artifacts (web/ is a real Vite project; only source is tracked)
web/node_modules/
web/dist/
web/*.tsbuildinfo
web/.vite/

# IDE
.trae/

# Runtime state (databases, sessions, run logs)
sessions/
runs/
current.json
# Runtime-generated address files (written by config.WriteAddrFile into workDir)
addr.*.json

# AI working memory (tool-internal, not project source)
.workbuddy/

# Runtime capture artifacts (binaries, recorded packets, reports)
cap/

# Stray/junk file
NUL

# 运行时产物（本地生成，不入库）
bin/
runs/
sessions/
cap/
current.json
/workflows/

# Windows 保留名伪文件
NUL

# Local Go workspace (SDK local dev), do not commit
go.work
go.work.sum
